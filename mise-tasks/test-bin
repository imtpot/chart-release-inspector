#!/usr/bin/env bash
#MISE description="Smoke test the built binary against the README, kserve, kustomize, and batch examples"
#MISE depends=["test"]
set -euo pipefail

bin="./bin/chart-release-inspector"

run() {
	echo "==> $bin $*"
	"$bin" "$@"
	echo
}

# README: classic Helm repository
run inspect \
	--chart external-secrets \
	--repository https://charts.external-secrets.io \
	--version 2.6.0 \
	--values-diff

# README: OCI chart
run inspect \
	--chart oci://ghcr.io/grafana/helm-charts/grafana \
	--version 10.5.14

# README: batch manifest
run batch --file charts.example.yaml

# kserve: OCI tags published with a "v" prefix (regression check)
run inspect \
	--chart oci://ghcr.io/kserve/charts/kserve-resources \
	--version v0.19.0

# kserve: same three charts as a batch manifest
run batch --file mise-tasks/testdata/batch.yaml

# kserve: same three charts via a kustomization.yaml's helmCharts
run kustomize --file mise-tasks/testdata/kustomization.yaml

echo "test-bin: all smoke checks passed"
